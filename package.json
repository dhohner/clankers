{
  "name": "clankers",
  "version": "0.1.0",
  "private": true,
  "description": "Agent plugin collection.",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./plugins/output-styles/index.ts",
      "./plugins/security-guard/index.ts"
    ]
  },
  "files": [
    "README.md",
    "LICENSE",
    "plugins/output-styles/index.ts",
    "plugins/output-styles/lib/**",
    "plugins/output-styles/styles/**",
    "plugins/output-styles/examples/**",
    "plugins/output-styles/tsconfig.json",
    "plugins/output-styles/tsconfig.build.json",
    "plugins/output-styles/package.json",
    "plugins/output-styles/README.md",
    "plugins/output-styles/LICENSE",
    "plugins/security-guard/index.ts",
    "plugins/security-guard/lib/**",
    "plugins/security-guard/package.json",
    "plugins/security-guard/README.md"
  ],
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.0"
  }
}
