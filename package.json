{
  "name": "clankers",
  "version": "0.1.0",
  "private": true,
  "description": "Agent plugin collection.",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  },
