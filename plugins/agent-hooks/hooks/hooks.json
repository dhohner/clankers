{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_in_terminal|runTerminalCommand",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/credential-guard.sh\" command",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/credential-guard.sh\" path",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
