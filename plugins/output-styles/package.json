{
  "name": "output-styles",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension that selects a named response style and applies it to the agent system prompt.",
  "keywords": [
    "extension",
    "output-style",
    "pi-package",
    "system-prompt"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "dhohner"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dhohner/clankers.git",
    "directory": "plugins/output-styles"
  },
  "files": [
    "README.md",
    "index.ts",
    "lib/**",
    "styles/**",
    "examples/**",
    "tsconfig.json",
    "tsconfig.build.json",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run format:check && vitest run --coverage && pnpm run typecheck"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-istanbul": "^4.1.11",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
