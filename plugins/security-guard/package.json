{
  "name": "security-guard",
  "version": "0.5.1",
  "private": true,
  "description": "Pi extension that blocks environment dumps and common local credential access and asks for approval before destructive commands.",
  "keywords": [
    "credentials",
    "guardrails",
    "pi-package",
    "security"
  ],
  "license": "MIT",
  "author": {
    "name": "dhohner"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dhohner/clankers.git",
    "directory": "plugins/security-guard"
  },
  "files": [
    "README.md",
    "index.ts",
    "src/**",
    "tsconfig.json",
    "tsconfig.build.json",
    "package.json",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm exec vitest run",
    "lint": "oxlint --max-warnings=0",
    "lint:anti-slop": "oxlint --config .oxlintrc.anti-slop.json --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run format:check && pnpm test && pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
